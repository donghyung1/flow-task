[Unit]
Description=Flow Task task manager (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flow-task
Group=flow-task
# 설정(.env)은 WorkingDirectory 기준으로 앱이 직접 읽고, EnvironmentFile로도 주입됩니다.
WorkingDirectory=/opt/flow-task
EnvironmentFile=/opt/flow-task/.env
ExecStart=/opt/flow-task/.venv/bin/flow-task
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
